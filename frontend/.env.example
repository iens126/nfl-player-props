VITE_ODDS_BASE_URL=
# Empty means same-origin /api, which is what Vercel serves.

# Accounts and the leaderboard. Leave both blank to run without them: picks
# stay private to the browser and the leaderboard tab says so. Both values are
# safe in the browser — the anon key only reaches tables behind row-level
# security, and no table grants INSERT to anyone. See supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
