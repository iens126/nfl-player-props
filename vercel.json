{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'no root package.json; install runs inside frontend/'",
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python@4.3.0",
      "includeFiles": "core/**"
    }
  },
  "headers": [
    {
      "source": "/data/players/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|data/|assets/).*)", "destination": "/index.html" }
  ]
}
