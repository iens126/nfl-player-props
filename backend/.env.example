# Comma-separated list of origins allowed to call this API (your deployed
# frontend URL(s) + local dev). No trailing slashes.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Live sportsbook odds (optional). Without this the odds panel explains that it
# is unconfigured and everything else works normally.
# Free key (500 credits/month): https://the-odds-api.com
# Player props bill per event per market, so responses are cached - see
# ODDS_CACHE_MINUTES to trade freshness against credits.
ODDS_API_KEY=
ODDS_CACHE_MINUTES=10

# Seasons of history to load for career views and model training.
CAREER_SEASONS=8
